# KiraCode ProGuard Rules
# MVP 阶段不开启混淆，但保留规则以备后续使用

# Kotlinx Serialization
-keep class kotlinx.serialization.** { *; }
-keep @kotlinx.serialization.Serializable class * { *; }
-keepclassmembers class * {
    @kotlinx.serialization.Serializable *;
}

# Room
-keep class androidx.room.** { *; }
-keep class * extends androidx.room.RoomDatabase { *; }
-keep @androidx.room.Entity class * { *; }
-keep @androidx.room.Dao interface * { *; }
-keep @androidx.room.TypeConverters class * { *; }

# Hilt / Dagger
-keep class dagger.** { *; }
-keep class com.google.dagger.** { *; }
-keep class * extends dagger.hilt.android.HiltAndroidApp { *; }
-keep class * extends dagger.hilt.android.HiltViewModel { *; }
-keepclassmembers class * {
    @dagger.hilt.android.qualifiers.* *;
    @dagger.hilt.android.scopes.* *;
}

# Ktor
-keep class io.ktor.** { *; }
-keep interface io.ktor.client.** { *; }

# Coil
-keep class coil.** { *; }

# Coroutines
-keep class kotlinx.coroutines.** { *; }

# Compose
-keep class androidx.compose.** { *; }
-keep class androidx.activity.compose.** { *; }
-keep class androidx.lifecycle.viewmodel.compose.** { *; }
-keep class androidx.navigation.compose.** { *; }

# DataStore
-keep class androidx.datastore.** { *; }

# Model classes (generated by serialization)
-keep class com.kirakira.kiracode.domain.model.** { *; }
-keep class com.kirakira.kiracode.data.remote.dto.** { *; }
-keep class com.kirakira.kiracode.data.local.db.entity.** { *; }

# Keep names for reflection (e.g., Hilt, Room, Serialization)
-keepnames class com.kirakira.kiracode.** { *; }

# JSON serialization field names
-keepclassmembers class * {
    @kotlinx.serialization.json.JsonNames *;
}